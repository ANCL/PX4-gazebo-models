<?xml version="1.0" encoding="UTF-8"?>
<sdf version='1.9'>
  <model name='slung_load'>
    <plugin filename="gz-sim-odometry-publisher-system" name="gz::sim::systems::OdometryPublisher">
      <odom_frame>world</odom_frame>
      <robot_base_frame>load</robot_base_frame>
      <odom_topic>/model/px4vision_sls_0/load_odom</odom_topic>
      <odom_publish_frequency>100</odom_publish_frequency>
      <dimensions>3</dimensions>
    </plugin>

    <self_collide>false</self_collide>
    <static>false</static>

    <link name='load'>
      <pose>0 0 0 0 0 0</pose>
      <inertial>
        <mass>0.3</mass>
        <inertia>
          <ixx>0.0000625</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.0000625</iyy>
          <iyz>0</iyz>
          <izz>0.0000625</izz>
        </inertia>
      </inertial>
      <visual name='load_visual'>
        <geometry>
          <sphere>
            <radius>0.025</radius>
          </sphere>
        </geometry>
        <material>
          <ambient>1.0 0.0 0.0 1.0</ambient>
          <diffuse>1.0 0.0 0.0 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
    </link>

    <link name='pendulum'>
      <pose>0 0 0.425 0 0 0</pose>
      <inertial>
        <mass>0.01</mass>
        <inertia>
          <ixx>0.00060208</ixx>
          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyy>0.00060208</iyy>
          <iyz>0</iyz>
          <izz>0.000000005</izz>
        </inertia>
      </inertial>
      <visual name='pendulum_visual'>
        <geometry>
          <cylinder>
            <radius>0.001</radius>
            <length>0.75</length>
          </cylinder>
        </geometry>
        <material>
          <ambient>1.0 1.0 1.0 1.0</ambient>
          <diffuse>1.0 1.0 1.0 1.0</diffuse>
        </material>
      </visual>
      <gravity>1</gravity>
    </link>

    <joint name='load_joint' type='ball'>
      <pose>0 0 0 0 0 0</pose>
      <child>load</child>
      <parent>pendulum</parent>
    </joint>
  </model>
</sdf>
